# Secrets: appsettings.json carries the Telegram bot token.
# The credential-free template (appsettings.ci.json) is version-controlled.
appsettings.json
!appsettings.ci.json
.env
.env.*
*.key
*.pem

# Note: state/notified-symbols.json IS intentionally version-controlled — it's the
# bot's memory across GitHub Actions runs. Local copies live in bin/ and publish/,
# already ignored below.

# .NET
bin/
obj/
publish/
*.user
*.suo

# Editors / OS
.vs/
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
Logs/
*.log

# Local Claude Code config (per machine)
.claude/settings.local.json
